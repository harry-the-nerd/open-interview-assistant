{
  "name": "open-interview-assistant",
  "version": "1.0.0",
  "private": false,
  "description": "Open-source interview overlay \u2014 invisible on screenshare, no mic or system recording permission (no privacy light), mouse pass-through, keyboard-only. Reads page text via Chrome extension. From DarkInterview.",
  "license": "Apache-2.0",
  "author": "DarkInterview (https://darkinterview.com)",
  "homepage": "https://harry-the-nerd.github.io/open-interview-assistant/",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently --kill-others \"vite --port 5180 --strictPort\" \"wait-on http://localhost:5180 && npm run build:electron && cross-env NODE_ENV=development electron .\"",
    "build": "vite build && npm run build:electron",
    "build:electron": "tsc -p electron/tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.3.1",
    "electron": "43.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harry-the-nerd/open-interview-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/harry-the-nerd/open-interview-assistant/issues"
  },
  "keywords": [
    "interview",
    "interview-assistant",
    "coding-interview",
    "electron",
    "chrome-extension",
    "overlay",
    "open-source",
    "leetcode",
    "darkinterview"
  ]
}
